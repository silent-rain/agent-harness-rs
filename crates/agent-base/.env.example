# =============================================================================
# agent-base examples - 模型配置（OpenAI 兼容协议）
# =============================================================================
# 用于 `cargo run -p agent-base --example basic_agent` 等示例。
# 复制本文件为 `.env` 并填写真实值；`.env` 已被 .gitignore 忽略。

# 必填：API Key
OPENAI_API_KEY=sk-your-api-key-here

# 可选：API 基础地址（默认 https://api.openai.com/v1）
# 兼容 OpenAI / DeepSeek / Qwen DashScope / 本地 vLLM 等。
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：模型编码（默认 gpt-4o）
OPENAI_MODEL=qwen-plus

# 可选：供应商标识，仅作记录用途（默认 openai）
OPENAI_PROVIDER=qwen

# 可选：采样温度（0.0 ~ 2.0，默认 0.7）
OPENAI_TEMPERATURE=0.7
