# =========== 日志 ===========
RUST_BACKTRACE=1
RUST_LOG=trace

# =========== 数据库配置 ===========
# Sqlite3
DATABASE_URL=sqlite://./data.dat?mode=rwc

# MySQL
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/dbname

# PostgreSQL
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/dbname?currentSchema=public
