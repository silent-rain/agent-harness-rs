# =============================================================================
# agent-runtime examples - 模型配置（OpenAI 兼容协议）
# =============================================================================
# 用于 `cargo run -p agent-runtime --example basic_agent` 等示例。
# 复制本文件为 `.env` 并填写真实值；`.env` 已被 .gitignore 忽略。

# 必填：API Key
OPENAI_API_KEY=sk-your-api-key-here

# 可选：API 基础地址（默认 https://api.openai.com/v1）
# 兼容 OpenAI / DeepSeek / Qwen DashScope / 本地 vLLM 等。
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：模型编码（默认 gpt-4o）
OPENAI_MODEL=qwen-plus

# 可选：供应商标识，仅作记录用途（默认 openai）
OPENAI_PROVIDER=qwen

# 可选：采样温度（0.0 ~ 2.0，默认 0.7）
OPENAI_TEMPERATURE=0.7

# =============================================================================
# agent-platform examples - 数据库驱动示例（仅 db_agent 使用）
# =============================================================================
# 用于 `cargo run -p agent-platform --example db_agent`。
# 模型 provider/base_url/api_key 由数据库的 t_agent_llm_model 提供，无需在此配置。

# 必填：SeaORM 兼容的数据库连接串
# DATABASE_URL=postgres://user:pass@localhost:5432/nucleus
# DATABASE_URL=mysql://user:pass@localhost:3306/nucleus

# 可选：要装配的智能体主键（默认 1）
AGENT_ID=1

# 可选：调用方用户 ID，用于权限隔离（默认 1）
USER_ID=1

# 可选：会话 ID（缺省按时间戳自动生成）
AGENT_SESSION_ID=db-example-001

# 可选：用户输入（缺省使用内置示例输入）
# AGENT_USER_INPUT=请简单介绍一下你自己。
